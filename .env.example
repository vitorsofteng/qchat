# QChat — exemplo de configuracao. Copie para .env e ajuste.

# Aplicacao
APP_NAME=QChat
ENVIRONMENT=development
DEBUG=true

# Seguranca / JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
BCRYPT_COST=12

# Banco de dados (somente usuarios e logs; mensagens nunca sao persistidas)
DATABASE_URL=sqlite:///./qchat.db

# CORS (origens do frontend, separadas por virgula)
CORS_ORIGINS=http://localhost:4200

# Sessao
SESSION_TIMEOUT_MINUTES=30

# Parametros BB84
BB84_QUBITS=4096
QBER_THRESHOLD=0.15
CASCADE_PASSES=4

# ML-KEM
MLKEM_LEVEL=ML-KEM-768

# Adversario simulado (NUNCA em producao): PASSIVE | INTERCEPT_RESEND | BEAM_SPLITTING
EVE_MODE=PASSIVE
EVE_BEAM_SPLIT_FRACTION=0.1

# WebSocket
WS_HEARTBEAT_SECONDS=30
